-- makeen_qemu.machine -- the Makeen box as QEMU's virt machine can carry
-- it: aarch64, hosted, a persistent ext4 partition, a network that asks
-- for its address (QEMU's user-mode network answers: 10.0.2.15, router
-- 10.0.2.2, dns 10.0.2.3 -- the dhcp oracle), the two worlds of the
-- counter. makeen_box.machine (fixture A2, the box's own truth) names the
-- SD card partition and a static address; this sibling names what the
-- emulator court can boot today and differs in nothing else that matters.

DEFINE MACHINE makeen_qemu AS (
  PROFILE hosted,
  ARCH aarch64,
  KERNEL linux,
  LIBC musl,
  CONSOLE "/dev/ttyAMA0"
) RATIONALE "The counter box, emulated: one box, no shell, no package manager, a persistent /data, a leased address"

DEFINE CAPABILITY process AS (
  GRANT yes
) RATIONALE "The worlds are processes"

DEFINE CAPABILITY filesystem AS (
  GRANT yes
) RATIONALE "Orders and stock live on the box"

DEFINE CAPABILITY network AS (
  GRANT yes
) RATIONALE "The worlds speak to the phones"

DEFINE CAPABILITY gpio AS (
  GRANT no
) RATIONALE "No pins on the counter box; sensors are edge machines"

DEFINE MOUNT data AS (
  AT "/data",
  FS ext4,
  DEVICE "/dev/vda",
  OPTIONS [rw, noatime]
) RATIONALE "The persistent partition -- a virtio disk here, the SD card's second partition on the box"

DEFINE NETWORK lan AS (
  INTERFACE "eth0",
  ADDRESS dhcp
) RATIONALE "The emulator's network hands out the address; the court judges the lease"

DEFINE SERVICE kds AS (
  RUN ["/stzr", "/app/kds.luau"],
  RESTART always,
  READY "/run/kds.ready",
  HEALTH 5,
  NEEDS [process, filesystem, network]
) RATIONALE "The kitchen display world: a daemon that says when it is serving"

DEFINE SERVICE poste AS (
  RUN ["/stzr", "/app/poste.luau"],
  RESTART always,
  READY "/run/poste.ready",
  HEALTH 5,
  AFTER [kds],
  NEEDS [process, filesystem, network]
) RATIONALE "The counter world: a daemon, after the kitchen display is serving"
