-- wsl_rehearsal.machine -- a hosted machine whose services exist on any
-- Linux (coreutils and util-linux), so the init can be exercised under
-- WSL: as a rehearsal from an ordinary pid, and as PID 1 inside a user
-- namespace (`unshare -Urpf --mount-proc`). Every RESTART policy is
-- represented, so the reaper's three branches all print, and both sides
-- of READY are here: a daemon that signals and one that never does.

DEFINE MACHINE wsl_rehearsal AS (
  PROFILE hosted,
  ARCH x86_64,
  KERNEL linux
) RATIONALE "The init exercised on the only Linux this host has"

DEFINE CAPABILITY process AS (
  GRANT yes
) RATIONALE "The services are processes and nothing more"

DEFINE SERVICE once AS (
  RUN ["/bin/true"],
  RESTART never,
  NEEDS [process]
) RATIONALE "Exits 0 and is never restarted"

DEFINE SERVICE flaky AS (
  RUN ["/bin/false"],
  RESTART on_failure,
  AFTER [once],
  NEEDS [process]
) RATIONALE "Exits 1 and is restarted until init gives up"

DEFINE SERVICE steady AS (
  RUN ["/bin/sleep", "1"],
  RESTART always,
  AFTER [once],
  NEEDS [process]
) RATIONALE "Sleeps a second and is always restarted"

DEFINE SERVICE signals AS (
  RUN ["/usr/bin/flock", "/tmp/stzos-signals.ready", "/bin/sleep", "30"],
  RESTART always,
  READY "/tmp/stzos-signals.ready",
  HEALTH 2,
  NEEDS [process]
) RATIONALE "A daemon stand-in that creates its signal and stays alive, as a real world does"

DEFINE SERVICE after_signals AS (
  RUN ["/bin/true"],
  RESTART never,
  AFTER [signals],
  NEEDS [process]
) RATIONALE "Starts on the signal, not on the spawn"

DEFINE SERVICE mute AS (
  RUN ["/bin/sleep", "30"],
  RESTART always,
  READY "/tmp/stzos-mute.ready",
  NEEDS [process]
) RATIONALE "A daemon stand-in that runs and never signals: the negative sibling"

DEFINE SERVICE after_mute AS (
  RUN ["/bin/true"],
  RESTART never,
  AFTER [mute],
  NEEDS [process]
) RATIONALE "Never starts: what it comes after never said it was serving"
